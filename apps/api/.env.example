# Copy to .env and adjust. All values are optional.
PORT=4000
HOST=127.0.0.1
# Comma separated list of origins allowed to call the API from a browser.
WEB_ORIGINS=http://localhost:3000
DATABASE_PATH=./data/siteshield.db
SCAN_CONCURRENCY=2
# Set to the number of proxies in front of the API (1 behind a single load balancer) so
# rate limits see the real client IP. Leave at 0 when the API is exposed directly.
TRUST_PROXY=0
# Scan requests allowed per client IP in a 10 minute window.
SCANS_PER_10_MIN=10
